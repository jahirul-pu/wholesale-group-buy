{
  "name": "wholesale-group-buy",
  "version": "1.0.0",
  "description": "Highly concurrent Group Buy platform schema and seed project",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "redis:start": "start cmd /k \"redis_dist\\redis-server.exe redis_dist\\redis.windows.conf\"",
    "postgres:start": "pg_dist\\pgsql\\bin\\pg_ctl.exe -D pg_data -l pg.log start",
    "postgres:stop": "pg_dist\\pgsql\\bin\\pg_ctl.exe -D pg_data stop",
    "services:start": "npm run postgres:start && npm run redis:start",
    "services:stop": "npm run postgres:stop"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.16.1",
    "bullmq": "^5.77.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.1",
    "typescript": "^5.4.5"
  }
}
